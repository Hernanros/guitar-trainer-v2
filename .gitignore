# Generated TypeScript types — baseline schema.d.ts IS committed (allows tsc without codegen).
# When codegen runs, it overwrites schema.d.ts in place. Other generated artifacts are ignored.
# Regenerate with: cd mobile && npm run codegen:local (FastAPI server must be running)
mobile/src/api/generated/*.js
mobile/src/api/generated/*.json

