# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Generated TypeScript types from OpenAPI (D-02).
# schema.d.ts is a committed baseline (TypeScript compiles without running codegen).
# Regenerate with: npm run codegen:local (FastAPI server must be running at localhost:8000)
# Note: ignore specific generated files, not the directory, so the negation !schema.d.ts works.
src/api/generated/*.json
src/api/generated/*.js

# Claude Code IDE settings
.claude/
