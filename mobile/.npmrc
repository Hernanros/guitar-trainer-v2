# EAS build uses `npm ci --include=dev` which enforces strict peer-dep
# resolution. openapi-typescript@7.13.0 pins `typescript: ^5.x` as a peer
# dep, but Expo SDK 57 pulls in typescript@6.x. The generated .d.ts output
# is compatible with TS 6 at runtime — the peer dep is just outdated
# upstream. Setting legacy-peer-deps=true here keeps EAS + local installs
# in sync until openapi-typescript ships a release that accepts TS 6.
legacy-peer-deps=true
